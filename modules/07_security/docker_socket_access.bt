tracepoint:syscalls:sys_enter_connect
{
    // AF_UNIX = 1
    if (args->uservaddr->sa_family == 1)
    {
        $sun_path = str((uint8 *)args->uservaddr + 2);
        if ($sun_path == "/var/run/docker.sock")
        {
            // Fase 3 do PLANO_ARTIGOS.md: ppid via curtask->real_parent->pid,
            // sintaxe confirmada ao vivo nesta VM (testado em suspicious_exec.bt, 2026-09-10).
            $ppid = curtask->real_parent->pid;
            printf("{\"evt\":\"docker_sock\",\"comm\":\"%s\",\"pid\":%d,\"ppid\":%d,\"uid\":%d,\"path\":\"%s\"}\n", comm, pid, $ppid, uid, $sun_path);
        }
    }
}