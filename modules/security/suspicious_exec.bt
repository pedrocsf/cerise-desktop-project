#!/usr/bin/env bpftrace
/*
 * suspicious_exec.bt - Detect suspicious process execution patterns
 * 
 * Monitors for potentially malicious execution behaviors:
 * - Binaries executed from /tmp or /dev/shm (common attack vectors)
 * - Execution without TTY (possible backdoor/automated attacks)
 * - Execution by unexpected users (privilege escalation)
 * 
 * Usage: bpftrace suspicious_exec.bt
 */

BEGIN
{
    printf("Monitoring suspicious executions... Press Ctrl-C to end.\n");
    printf("%-10s %-16s %-8s %-8s %-6s %-8s %s\n", 
           "TIME", "COMM", "PID", "PPID", "UID", "TTY", "PATH");
}

tracepoint:syscalls:sys_enter_execve
{
    $filename = str(args->filename);
    $has_tty = curtask->signal->tty != 0 ? 1 : 0;
    
    // Flag 1: Execution from temporary/suspicious directories
    $suspicious_path = 0;
    if ($filename =~ "/tmp/*" ||
        $filename =~ "/dev/shm/*" ||
        $filename =~ "/var/tmp/*")
    {
        $suspicious_path = 1;
    }
    
    // Flag 2: No TTY (potential automated/backdoor execution)
    $no_tty = !$has_tty;
    
    // Flag 3: Unexpected user (non-root running privileged commands)
    $unexpected_user = 0;
    if (uid != 0 && uid != 1000 && 
        ($filename =~ "*/sudo" || 
         $filename =~ "*/su" ||
         $filename =~ "*/pkexec"))
    {
        $unexpected_user = 1;
    }
    
    // Report if any suspicious condition is met
    if ($suspicious_path || $no_tty || $unexpected_user)
    {
        time("%H:%M:%S  ");
        printf("%-16s %-8d %-8d %-6d %-8s %s",
               comm,
               pid,
               curtask->real_parent->pid,
               uid,
               $has_tty ? "YES" : "NO",
               $filename);
        
        // Add warning flags
        if ($suspicious_path) { printf(" [SUSPICIOUS_PATH]"); }
        if ($no_tty) { printf(" [NO_TTY]"); }
        if ($unexpected_user) { printf(" [UNEXPECTED_USER]"); }
        printf("\n");
    }
}

END
{
    printf("\nMonitoring ended.\n");
}
