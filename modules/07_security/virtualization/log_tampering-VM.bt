/*
 * Detecta tentativas de escrita ou modificação em arquivos de log do sistema
 * pelo processo da QEMU.
 */

#include <linux/fcntl.h>

tracepoint:syscalls:sys_enter_openat
/
  comm == "qemu-system-x86_64" &&
  ( str(args->filename) == "/var/log/" ) &&
  ( args->flags & (O_WRONLY | O_RDWR) )
/
{
	time("%H:%M:%S ");
	printf("ALERTA: Processo QEMU (PID: %d) tentou modificar logs do sistema: %s\n",
	       pid, str(args->filename));
}