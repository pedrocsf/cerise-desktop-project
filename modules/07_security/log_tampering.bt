#define O_WRONLY 1
#define O_RDWR   2

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ( (strncmp($filename, "/var/log/", 9) == 0 || strncmp($filename, "/var/adm/", 8) == 0) && ((uint32)arg2 & (O_WRONLY | O_RDWR)) ) {
        printf("{\"e\":\"log_tamp\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"f\":\"%s\"}\n", comm, pid, uid, $filename);
    }
}
