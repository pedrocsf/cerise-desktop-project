#define O_WRONLY 1
#define O_RDWR   2

tracepoint:syscalls:sys_enter_openat
{
    $filename = str(args->filename);
    if ( (strncmp($filename, "/var/log/", 9) == 0 || strncmp($filename, "/var/adm/", 8) == 0) && (args->flags & (O_WRONLY | O_RDWR)) ) {
        printf("{\"e\":\"log_tamp\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"f\":\"%s\"}\n", comm, pid, uid, $filename);
    }
}