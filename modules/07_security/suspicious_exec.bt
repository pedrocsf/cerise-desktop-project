#!/usr/bin/env bpftrace

BEGIN
{
    printf("Monitoring suspicious executions... Press Ctrl-C to end.\n");
    printf("%-10s %-16s %-8s %-8s %-6s %s\n",
           "TIME", "COMM", "PID", "PPID", "UID", "PATH");
}

kprobe:security_bprm_check
{
    $bprm = (struct linux_binprm *)arg0;
    if ($bprm->recursion_depth != 0)
    {
        return;
    }
    $filename = str($bprm->filename);
    $ppid = curtask->real_parent->pid;

    $suspicious_path = 0;
    if (strncmp($filename, "/tmp/", 5) == 0 ||
        strncmp($filename, "/dev/shm/", 9) == 0 ||
        strncmp($filename, "/var/tmp/", 9) == 0)
    {
        $suspicious_path = 1;
    }
    
    $no_tty = 0;
    
    $unexpected_user = 0;
    if (uid != 0 && uid != 1000 &&
        ($filename == "/usr/bin/sudo" ||
         $filename == "/bin/su" ||
         $filename == "/usr/bin/su" ||
         $filename == "/usr/bin/pkexec" ||
         $filename == "/bin/pkexec"))
    {
        $unexpected_user = 1;
    }

    $shell_interpreter = 0;
    if ($filename == "/bin/sh" ||
        $filename == "/bin/bash" ||
        $filename == "/bin/dash" ||
        $filename == "/usr/bin/sh" ||
        $filename == "/usr/bin/bash" ||
        $filename == "/usr/bin/dash")
    {
        $shell_interpreter = 1;
    }

    if ($suspicious_path || $no_tty || $unexpected_user || $shell_interpreter)
    {
        printf("TIME: ");
        time("%H:%M:%S  ");
        printf("COMM: %-16s PID: %-8d PPID: %-8d UID: %-6d PATH: %s FLAGS:",
               comm,
               pid,
               $ppid,
               uid,
               $filename);

        if ($suspicious_path) { printf(" [SUSPICIOUS_PATH]"); }
        if ($unexpected_user) { printf(" [UNEXPECTED_USER]"); }
        if ($shell_interpreter) { printf(" [SHELL_INTERPRETER]"); }
        printf("\n");
    }
}

kprobe:do_renameat2
{
    $path = (uint8 *)arg3;
    $index = 0;
    $served = 0;
    while ($index < 59)
    {
        if (*($path + $index) == 0)
        {
            break;
        }
        $window = str($path + $index, 10);
        if (($index <= 54 && strncmp($window, "/uploads/", 9) == 0) ||
            ($index <= 56 && strncmp($window, "/media/", 7) == 0) ||
            ($index <= 58 && strncmp($window, "/www/", 5) == 0) ||
            ($index <= 55 && strncmp($window, "/htdocs/", 8) == 0))
        {
            $served = 1;
            break;
        }
        $index += 1;
    }
    if ($served)
    {
        $ppid = curtask->real_parent->pid;
        printf("TIME: ");
        time("%H:%M:%S  ");
        printf("COMM: %-16s PID: %-8d PPID: %-8d UID: %-6d RENAME_TO: %s FLAGS: [MOVED_TO_SERVED_DIR]\n",
               comm, pid, $ppid, uid, str(arg3));
    }
}

kprobe:do_fchmodat
{
    $ppid = curtask->real_parent->pid;
    printf("TIME: ");
    time("%H:%M:%S  ");
    printf("COMM: %-16s PID: %-8d PPID: %-8d UID: %-6d FLAGS: [CHMOD_CALLED]\n",
           comm, pid, $ppid, uid);
}

END
{
    printf("\nMonitoring ended.\n");
}
