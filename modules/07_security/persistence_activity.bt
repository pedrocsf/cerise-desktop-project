#define MASS_FILE_OPS_THRESHOLD 50
#define OPEN_WRITE_FLAGS 0x643

kprobe:do_sys_open
{
    if ((uint32)arg2 & OPEN_WRITE_FLAGS)
    {
        @cnt[pid, 3] += 1;
        if (@cnt[pid, 3] >= MASS_FILE_OPS_THRESHOLD && @flag[pid, 3] == 0)
        {
            @flag[pid, 3] = 1;
            $slot = @noff;
            if ($slot < 32)
            {
                @offpid[$slot] = pid;
                @offop[$slot] = 3;
                @offcomm[$slot] = comm;
                @offuid[$slot] = uid;
                @noff = $slot + 1;
            }
        }
        $path = (uint8 *)arg1;
        $hit = 0;
        $index = 0;
        while ($index < 100)
        {
            $first = *($path + $index);
            if ($first == 0)
            {
                break;
            }
            if ($first == 47 || $index == 0)
            {
                $w0 = *(uint64 *)($path + $index);
                $w1 = *(uint64 *)($path + $index + 8);
                $w2 = *(uint64 *)($path + $index + 16);
                if ($first != 47)
                {
                    $w2 = ($w1 >> 56) | ($w2 << 8);
                    $w1 = ($w0 >> 56) | ($w1 << 8);
                    $w0 = ($w0 << 8) | 47;
                }
                if (
                        ($w0 == 0x6769666e6f632e2f && $w1 == 0x6174736f7475612f && ($w2 & 0xffffff) == 0x2f7472) ||
                        ($w0 == 0x6f72632f6374652f && ($w1 & 0xff) == 0x6e) ||
                        ($w0 == 0x6f70732f7261762f && $w1 == 0x2f6e6f72632f6c6f) ||
                        ($w0 == 0x7379732f6374652f && $w1 == 0x7379732f646d6574 && ($w2 & 0xffffffff) == 0x2f6d6574) ||
                        ($w0 == 0x7379732f62696c2f && $w1 == 0x7379732f646d6574 && ($w2 & 0xffffffff) == 0x2f6d6574) ||
                        ($w0 == 0x6769666e6f632e2f && $w1 == 0x646d65747379732f && ($w2 & 0xffffffffffff) == 0x2f726573752f) ||
                        ($w0 == 0x2e63722f6374652f && ($w1 & 0xffffffffff) == 0x6c61636f6c) ||
                        ($w0 == 0x696e692f6374652f && ($w1 & 0xffffffff) == 0x2f642e74) ||
                        ($w0 == 0x6372687361622e2f) ||
                        ($w0 == 0x6c69666f72702e2f && ($w1 & 0xff) == 0x65) ||
                        ($w0 == 0x705f687361622e2f && ($w1 & 0xffffffffffff) == 0x656c69666f72) ||
                        ($w0 == 0x7274696e69782e2f && ($w1 & 0xff) == 0x63) ||
                        ($w0 == 0x69666f7270782e2f && ($w1 & 0xffff) == 0x656c) ||
                        ($w0 == 0x6f72702f6374652f && ($w1 & 0xffffffffffffff) == 0x2f642e656c6966) ||
                        ($w0 == 0x2e646c2f6374652f && $w1 == 0x6f6c6572702e6f73 && ($w2 & 0xffff) == 0x6461)
                )
                {
                    $hit = 1;
                    break;
                }
            }
            $index += 1;
        }
        if ($hit)
        {
            $ppid = curtask->real_parent->pid;
            printf("{\"e\":\"persistence\",\"c\":\"%s\",\"p\":%d,\"pp\":%d,\"u\":%d,\"op\":\"open_write\",\"f\":\"%s\"}\n",
                   comm, pid, $ppid, uid, str(arg1));
        }
    }
}

