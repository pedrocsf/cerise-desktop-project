/*
 * Detecta tentativas de escalação de privilégios (setuid, setgid)
 * pelo processo da QEMU.
 */

BEGIN {
	printf("Rastreando tentativas de escalação de privilégio por 'qemu-system-x86_64'...\n");
}

tracepoint:syscalls:sys_enter_setuid,
tracepoint:syscalls:sys_enter_setgid
/ comm == "qemu-system-x86_64" /
{
	time("%H:%M:%S ");
	printf("ALERTA: Processo QEMU (PID: %d, UID: %d) tentou escalar privilégios via '%s' para UID/GID %d\n",
	       pid, uid, probe, args->uid);
}