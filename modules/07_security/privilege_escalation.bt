#!/usr/bin/env bpftrace

kprobe:__sys_setuid
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-10s uid: %d -> %d\n",
           comm,
           pid,
           uid,
           "setuid",
           uid,
           (uint32)arg0);
}

kprobe:__sys_setgid
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-10s gid: %d -> %d\n",
           comm,
           pid,
           uid,
           "setgid",
           gid,
           (uint32)arg0);
}

kprobe:__sys_setreuid
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-10s ruid=%d, euid=%d\n",
           comm,
           pid,
           uid,
           "setreuid",
           (uint32)arg0,
           (uint32)arg1);
}

kprobe:__sys_setresuid
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-10s ",
           comm,
           pid,
           uid,
           "setresuid");
    printf("ruid=%d, euid=%d, suid=%d\n",
           (uint32)arg0,
           (uint32)arg1,
           (uint32)arg2);
}

kprobe:__x64_sys_capset,
kprobe:__ia32_sys_capset
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-10s capabilities modified\n",
           comm,
           pid,
           uid,
           "capset");
}
