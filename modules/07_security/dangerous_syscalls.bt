#!/usr/bin/env bpftrace

BEGIN
{
    printf("Monitoring dangerous syscalls... Press Ctrl-C to end.\n");
    printf("%-10s %-16s %-8s %-8s %-6s ", "TIME", "COMM", "PID", "PPID", "UID");
    printf("%-16s %s\n", "SYSCALL", "DETAILS");
}

kprobe:__x64_sys_ptrace
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "ptrace");
    printf("request=%d, pid=%d\n",
           ((struct pt_regs *)arg0)->di,
           ((struct pt_regs *)arg0)->si);
}

kprobe:__ia32_compat_sys_ptrace,
kprobe:__ia32_sys_ptrace
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "ptrace");
    printf("request=%d, pid=%d\n",
           ((struct pt_regs *)arg0)->bx,
           ((struct pt_regs *)arg0)->cx);
}

kprobe:do_mount
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "mount");
    printf("dev=%s, dir=%s, type=%s\n",
           str(arg0),
           str(arg1),
           str(arg2));
}

kprobe:ksys_umount
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "umount");
    printf("target=%s\n",
           str(arg0));
}

kprobe:__x64_sys_setns
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "setns");
    printf("fd=%d, nstype=%d\n",
           (int32)((struct pt_regs *)arg0)->di,
           (int32)((struct pt_regs *)arg0)->si);
}

kprobe:__ia32_sys_setns
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "setns");
    printf("fd=%d, nstype=%d\n",
           (int32)((struct pt_regs *)arg0)->bx,
           (int32)((struct pt_regs *)arg0)->cx);
}

kprobe:ksys_unshare
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "unshare");
    printf("flags=0x%x\n",
           arg0);
}

kprobe:__x64_sys_bpf
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "bpf");
    printf("cmd=%d\n",
           (int32)((struct pt_regs *)arg0)->di);
}

kprobe:__ia32_sys_bpf
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "bpf");
    printf("cmd=%d\n",
           (int32)((struct pt_regs *)arg0)->bx);
}

kprobe:__x64_sys_kexec_load
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "kexec_load");
    printf("entry=0x%lx\n",
           ((struct pt_regs *)arg0)->di);
}

kprobe:__ia32_compat_sys_kexec_load,
kprobe:__ia32_sys_kexec_load
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "kexec_load");
    printf("entry=0x%lx\n",
           ((struct pt_regs *)arg0)->bx);
}

kprobe:ksys_chroot
{
    $ppid = curtask->real_parent->pid;
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           $ppid,
           uid,
           "chroot");
    printf("path=%s\n",
           str(arg0));
}

kprobe:group_send_sig_info,
kprobe:do_send_sig_info
{
    $sig = (int32)arg0;
    $target = (struct task_struct *)arg2;
    if ($sig == 9 || $sig == 15 || $sig == 19) {
        if (strncmp($target->comm, "bpftrace", 8) == 0 ||
            strncmp($target->comm, "guest_monitor", 13) == 0 ||
            strncmp($target->comm, "supervisor_monit", 16) == 0) {
            printf("{\"e\":\"sensor_tamper\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"s\":%d,\"t\":\"%s\",\"tp\":%d}\n",
                   comm, pid, uid, $sig, $target->comm, $target->tgid);
        }
    }
}

END
{
    printf("\nMonitoring ended.\n");
}
