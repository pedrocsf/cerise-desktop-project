/*
 * Monitora o uso de syscalls perigosas (ptrace, mount, setns, bpf)
 * pelo processo da QEMU.
 */

BEGIN {
	printf("Rastreando syscalls perigosas executadas por 'qemu-system-x86_64'...\n");
}

tracepoint:raw_syscalls:sys_enter
/
  comm == "qemu-system-x86_64" &&
  ( args->id == 101 || /* ptrace */
    args->id == 165 || /* mount */
    args->id == 308 || /* setns */
    args->id == 321 )  /* bpf */
/
{
	time("%H:%M:%S ");
	printf("ALERTA: Processo QEMU (PID: %d) usou syscall perigosa. ID: %d\n", pid, args->id);
}