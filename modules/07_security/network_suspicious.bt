#!/usr/bin/env bpftrace

BEGIN
{
    printf("Monitoring suspicious network activity... Press Ctrl-C to end.\n");
    
    // Common suspicious ports
    @suspicious_ports[4444] = 1;  // Metasploit default
    @suspicious_ports[31337] = 1; // Elite/leet
    @suspicious_ports[12345] = 1; // NetBus
    @suspicious_ports[54321] = 1; // Back Orifice
}

tracepoint:syscalls:sys_enter_connect
{
    // Get the sockaddr family from the first 2 bytes of uservaddr
    $addr = (uint64)args->uservaddr;
    $sa_family = *(uint16 *)$addr;
    
    if ($sa_family == 2) // AF_INET
    {
        // struct sockaddr_in layout:
        // sin_family (2 bytes) + sin_port (2 bytes) + sin_addr (4 bytes)
        $port_network = *(uint16 *)($addr + 2);
        // Convert from network byte order to host byte order
        $port = ($port_network >> 8) | (($port_network << 8) & 0xff00);
        
        $addr_int = *(uint32 *)($addr + 4);
        
        $suspicious = 0;
        
        // Check for suspicious ports
        if (@suspicious_ports[$port]) {
            $suspicious = 1;
        }
        
        // Check for shell processes making connections
        if (comm == "sh" || comm == "bash" || comm == "dash" || 
            comm == "zsh" || comm == "nc" || comm == "ncat") {
            $suspicious = 1;
        }
        
        // Convert IP to first octet for localhost check
        $a = ($addr_int & 0xff);
        
        // Check for localhost
        if ($a == 127) {
            if ($port > 10000) {
                $suspicious = 1;
            }
        }
        
        if ($suspicious) {
            printf("COMM: %-10s PID: %-6d UID: %-6d IP: %-15d:%d FLAGS: SUSPICIOUS\n",
                   comm,
                   pid,
                   uid,
                   $a,
                   $port);
        }
    }
}

END
{
    clear(@suspicious_ports);
    printf("\nMonitoring ended.\n");
}
