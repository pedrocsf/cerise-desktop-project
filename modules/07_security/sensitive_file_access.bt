#!/usr/bin/env bpftrace


BEGIN
{
    printf("Monitoring sensitive file access... Press Ctrl-C to end.\n");
}

tracepoint:syscalls:sys_enter_openat
{
    $filename = str(args->filename);
    
    $sensitive = 0;
    
    // Check for exact sensitive files
    if ($filename == "/etc/passwd" ||
        $filename == "/etc/shadow" ||
        $filename == "/etc/sudoers" ||
        $filename == "/root/.ssh/id_rsa" ||
        $filename == "/root/.ssh/authorized_keys" ||
        $filename == "/root/.bashrc" ||
        $filename == "/root/.bash_history" ||
        $filename == "/etc/ssh/id_rsa" ||
        $filename == "/etc/ssh/id_dsa" ||
        $filename == "/etc/ssh/id_ecdsa" ||
        $filename == "/etc/ssh/ssh_host_rsa_key" ||
        $filename == "/etc/ssh/ssh_host_dsa_key" ||
        $filename == "/etc/ssh/ssh_host_ecdsa_key" ||
        $filename == "/etc/ssh/ssh_host_ed25519_key" ||
        $filename == "/.ssh/id_rsa" ||
        $filename == "/.ssh/id_dsa" ||
        $filename == "/.ssh/authorized_keys" ||
        $filename == "/.ssh/config" ||
        $filename == "/proc/sys/kernel/modules" ||
        $filename == "/proc/cmdline" ||
        $filename == "/proc/version" ||
        $filename == "/.aws/credentials" ||
        $filename == "/.docker/config.json" ||
        $filename == "/var/log/auth.log" ||
        $filename == "/var/log/secure" ||
        $filename == "/var/log/audit/audit.log")
    {
        $sensitive = 1;
    }
    
    if ($sensitive) {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s\n",
               comm,
               pid,
               uid,
               args->flags,
               $filename);
    }
}

END
{
    printf("\nMonitoring ended.\n");
}
