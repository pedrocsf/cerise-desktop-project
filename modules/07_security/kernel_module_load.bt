tracepoint:syscalls:sys_enter_finit_module
{
    // Fase 3 do PLANO_ARTIGOS.md: ppid via curtask->real_parent->pid,
    // sintaxe confirmada ao vivo nesta VM (testado em suspicious_exec.bt, 2026-09-10).
