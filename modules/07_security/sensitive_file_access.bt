#!/usr/bin/env bpftrace


BEGIN
{
    printf("Monitoring sensitive file access... Press Ctrl-C to end.\n");
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/etc/passwd" ||
        $filename == "/etc/shadow" ||
        $filename == "/etc/sudoers" ||
        $filename == "/root/.ssh/id_rsa")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/root/.ssh/authorized_keys")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/root/.bashrc" ||
        $filename == "/root/.bash_history" ||
        $filename == "/etc/ssh/id_rsa")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/etc/ssh/id_dsa" ||
        $filename == "/etc/ssh/id_ecdsa")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/etc/ssh/ssh_host_rsa_key")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/etc/ssh/ssh_host_dsa_key")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/etc/ssh/ssh_host_ecdsa_key")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/etc/ssh/ssh_host_ed25519_key")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/.ssh/id_rsa" ||
        $filename == "/.ssh/id_dsa" ||
        $filename == "/.ssh/authorized_keys" ||
        $filename == "/.ssh/config")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/proc/sys/kernel/modules")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/proc/cmdline" ||
        $filename == "/proc/version" ||
        $filename == "/.aws/credentials")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/.docker/config.json" ||
        $filename == "/var/log/auth.log" ||
        $filename == "/var/log/secure")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $filename = str(arg1);
    if ($filename == "/var/log/audit/audit.log")
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               $filename,
               "");
    }
}

kprobe:do_sys_open
{
    $path = (uint8 *)arg1;
    $index = 0;
    $traversal = 0;
    while ($index < 61)
    {
        if (*($path + $index) == 0)
        {
            break;
        }
        if (*($path + $index) == 46 &&
            *($path + $index + 1) == 46 &&
            *($path + $index + 2) == 47)
        {
            $traversal = 1;
            break;
        }
        $index += 1;
    }
    if ($traversal)
    {
        printf("COMM: %-16s PID: %-8d UID: %-8d FLAGS: 0x%-4x FILE: %s%s\n",
               comm,
               pid,
               uid,
               (uint32)arg2,
               str(arg1),
               " [PATH_TRAVERSAL]");
    }
}

END
{
    printf("\nMonitoring ended.\n");
}
