#!/usr/bin/env bpftrace


BEGIN
{
    printf("Monitoring sensitive file access... Press Ctrl-C to end.\n");
    printf("%-10s %-16s %-8s %-8s %-6s %s\n", 
           "TIME", "COMM", "PID", "UID", "FLAGS", "FILE");
}

tracepoint:syscalls:sys_enter_openat
{
    $filename = str(args->filename);
    
    // Check for sensitive files
    if ($filename == "/etc/passwd" ||
        $filename == "/etc/shadow" ||
        $filename == "/etc/sudoers" ||
        $filename =~ "*/proc/*/mem" ||
        $filename =~ "*/root/.ssh/*" ||
        $filename =~ "*/.ssh/id_rsa*" ||
        $filename =~ "*/.ssh/authorized_keys" ||
        $filename =~ "/etc/ssh/*_key")
    {
        time("%H:%M:%S  ");
        printf("%-16s %-8d %-8d 0x%-4x %s\n",
               comm,
               pid,
               uid,
               args->flags,
               $filename);
    }
}

END
{
    printf("\nMonitoring ended.\n");
}
