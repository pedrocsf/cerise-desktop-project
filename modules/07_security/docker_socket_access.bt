tracepoint:syscalls:sys_enter_connect
{
    // AF_UNIX = 1
    if (args->addr->sa_family == 1)
    {
        $sun_path = ((struct sockaddr_un *)args->addr)->sun_path;
        if (str($sun_path) == "/var/run/docker.sock")
        {
            // Fase 3 do PLANO_ARTIGOS.md: ppid via curtask->real_parent->pid,
            // sintaxe ainda nao confirmada na VM alvo (depende de BTF).
            $ppid = curtask->real_parent->pid;
            printf("{\"evt\":\"docker_sock\",\"comm\":\"%s\",\"pid\":%d,\"ppid\":%d,\"uid\":%d,\"path\":\"%s\"}\n", comm, pid, $ppid, uid, str($sun_path));
        }
    }
}