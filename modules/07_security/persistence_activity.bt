interval:s:1
{
    $i = 0;
    while ($i < 32 && $i < (int64)@noff)
    {
        $offender = @offpid[$i];
        $operation = @offop[$i];
        $count = @cnt[$offender, $operation];
        if ($count >= MASS_FILE_OPS_THRESHOLD)
        {
            if ($operation == 0)
            {
                printf("{\"e\":\"mass_file_ops\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"op\":\"chmod\",\"n\":%d,\"w\":1}\n",
                       @offcomm[$i], $offender, @offuid[$i], $count);
            }
            if ($operation == 1)
            {
                printf("{\"e\":\"mass_file_ops\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"op\":\"rename\",\"n\":%d,\"w\":1}\n",
                       @offcomm[$i], $offender, @offuid[$i], $count);
            }
            if ($operation == 2)
            {
                printf("{\"e\":\"mass_file_ops\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"op\":\"unlink\",\"n\":%d,\"w\":1}\n",
                       @offcomm[$i], $offender, @offuid[$i], $count);
            }
            if ($operation == 3)
            {
                printf("{\"e\":\"mass_file_ops\",\"c\":\"%s\",\"p\":%d,\"u\":%d,\"op\":\"open_write\",\"n\":%d,\"w\":1}\n",
                       @offcomm[$i], $offender, @offuid[$i], $count);
            }
        }
        $i += 1;
    }
    clear(@cnt);
    clear(@flag);
    clear(@offpid);
    clear(@offop);
    clear(@offcomm);
    clear(@offuid);
    @noff = 0;
}

END
{
    clear(@cnt);
    clear(@flag);
    clear(@offpid);
    clear(@offop);
    clear(@offcomm);
    clear(@offuid);
    clear(@noff);
}
