#!/usr/bin/env bpftrace


BEGIN
{
    printf("Monitoring dangerous syscalls... Press Ctrl-C to end.\n");
    printf("%-10s %-16s %-8s %-8s %-6s %-16s %s\n", 
           "TIME", "COMM", "PID", "PPID", "UID", "SYSCALL", "DETAILS");
}

// ptrace - process debugging/injection
tracepoint:syscalls:sys_enter_ptrace
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "ptrace");
    printf("request=%d, pid=%d\n",
           args->request,
           args->pid);
}

// mount - filesystem manipulation
tracepoint:syscalls:sys_enter_mount
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "mount");
    printf("dev=%s, dir=%s, type=%s\n",
           str(args->dev_name),
           str(args->dir_name),
           str(args->type));
}

// umount - filesystem unmounting
tracepoint:syscalls:sys_enter_umount
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s target=%s\n",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "umount",
           str(args->name));
}

// setns - namespace manipulation (container escape)
tracepoint:syscalls:sys_enter_setns
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s ",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "setns");
    printf("fd=%d, nstype=%d\n",
           args->fd,
           args->nstype);
}

// unshare - namespace creation
tracepoint:syscalls:sys_enter_unshare
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s flags=0x%x\n",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "unshare",
           args->unshare_flags);
}

// bpf - eBPF program loading
tracepoint:syscalls:sys_enter_bpf
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s cmd=%d\n",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "bpf",
           args->cmd);
}

// kexec_load - kernel replacement
tracepoint:syscalls:sys_enter_kexec_load
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s entry=0x%lx\n",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "kexec_load",
           args->entry);
}

// chroot - change root directory
tracepoint:syscalls:sys_enter_chroot
{
    time("%H:%M:%S  ");
    printf("%-16s %-8d %-8d %-6d %-16s path=%s\n",
           comm,
           pid,
           curtask->real_parent->pid,
           uid,
           "chroot",
           str(args->filename));
}

END
{
    printf("\nMonitoring ended.\n");
}
