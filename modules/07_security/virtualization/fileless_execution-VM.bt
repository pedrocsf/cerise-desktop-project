/*

 * Detecta o uso de `memfd_create` pelo processo da QEMU para
 * possível execução de código em memória (fileless execution).
 */

tracepoint:syscalls:sys_enter_memfd_create
/ comm == "qemu-system-x86_64" /
{
	time("%H:%M:%S ");
	printf("ALERTA: Processo QEMU (PID: %d) usou memfd_create. Nome: %s, Flags: %x\n",
	       pid, str(args->name), args->flags);
}