/*
 * Rastreia o carregamento de módulos do kernel pelo processo da QEMU.
 * Esta é uma atividade extremamente suspeita.
 */

tracepoint:syscalls:sys_enter_init_module,
tracepoint:syscalls:sys_enter_finit_module
/ comm == "qemu-system-x86_64" /
{
	time("%H:%M:%S ");
	printf("ALERTA GRAVE: Processo QEMU (PID: %d) tentou carregar um módulo de kernel ('%s')!\n",
	       pid, probe);
}